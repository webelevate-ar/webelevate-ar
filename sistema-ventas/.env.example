# SQLite: es el de por defecto y no hace falta tocar nada.
# `npm run arrancar` genera este archivo solo, con un secreto nuevo.
DATABASE_URL="file:./prisma/dev.db"
COOKIE_SECRETO="poner-una-cadena-larga-y-aleatoria"

# PostgreSQL (producción). Descomentar las dos, y acordarse de correr
# `npx prisma generate` al cambiar de motor: el cliente lleva el motor adentro.
# MOTOR="postgresql"
# DATABASE_URL="postgresql://usuario:clave@host:5432/base?schema=public"
